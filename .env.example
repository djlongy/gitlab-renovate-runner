# Settings for ./run-local.sh. Copy to .env (git ignores it) and chmod 600 .env.
# run-local.sh reads .env itself, so the token never enters shell history.
# In CI the same names are CI/CD variables; the three required ones default there.
# Quote any value that contains a space.

# ---- Required ---------------------------------------------------------------
# Group access token (Settings > Access tokens on the group): role Developer,
# scopes api and write_repository. The token's name is the bot's display name
# on every merge request, so call it something like renovate-bot.
RENOVATE_TOKEN=
# Your GitLab's API URL.
RENOVATE_ENDPOINT=https://gitlab.example.com/api/v4
# Path of this project in your GitLab: the presets projects extend.
RENOVATE_PRESET_REPO=platform/renovate-runner

# ---- Scope: which projects to update ----------------------------------------
# Default: every project the token can see. For a first test, one project only:
# RENOVATE_AUTODISCOVER=false
# RENOVATE_REPOSITORIES=platform/my-app
# Or a pattern with autodiscovery left on:
# RENOVATE_AUTODISCOVER_FILTER=platform/**

# ---- Self-hosted and self-signed --------------------------------------------
# Internal CA: any PEM file, the system bundle included. It is added to the
# image's public roots. Never set NODE_TLS_REJECT_UNAUTHORIZED=0 instead.
# CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
# Hosts on private addresses that Renovate calls, besides GitLab, comma
# separated: registries, chart repos, preset servers. A bare name means https://;
# give http://host:port for anything else. Clears "HTTP request to an internal
# host" warnings. A host with a DOCKER_<HOST>_* pair below is already covered.
# Never put allowInternal in a project's renovate.json: Renovate rejects the
# whole config and skips that project.
# RENOVATE_INTERNAL_HOSTS=registry.example.com,charts.example.com
# Once a run logs no internal-host warning, enforce it (the default from v45).
# Avoid "allow": it lets any project's renovate.json reach every internal
# service, and Renovate removes it in v46.
# RENOVATE_INTERNAL_HOST_ACCESS=block
# Proxy for lookups on the internet. Keep GitLab and internal hosts in NO_PROXY.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=gitlab.example.com,registry.example.com

# ---- Registries -------------------------------------------------------------
# Image to run. Point it at your mirror if the host cannot reach docker.io.
# RENOVATE_IMAGE=registry.example.com/renovate/renovate:44.112.3-full
# Credentials per registry host: upper-case, with . - : as _. run-local.sh logs
# podman in to RENOVATE_IMAGE's host with the pair for that host, and Renovate
# uses every pair for its lookups. No manual podman login needed.
# DOCKER_REGISTRY_EXAMPLE_COM_USERNAME=robot
# DOCKER_REGISTRY_EXAMPLE_COM_PASSWORD=
# Lookups through a mirror, reported against the upstream. JSON, in single quotes:
# RENOVATE_REGISTRY_ALIASES_JSON='{"registry.example.com/dockerhub":"docker.io"}'

# ---- Troubleshooting --------------------------------------------------------
# LOG_LEVEL=debug
