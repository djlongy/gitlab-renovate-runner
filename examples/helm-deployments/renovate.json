{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>platform/renovate-runner",
    "local>platform/renovate-runner:helm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster resources name their PostgreSQL image in imageName.",
      "managerFilePatterns": ["/(^|/)environments/.+\\.ya?ml$/"],
      "matchStrings": ["imageName:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
